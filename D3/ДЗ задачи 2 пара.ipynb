   ],","   \"source\": [","    \"round(1 / sc.factorial(5), 4)\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"d02443be\",","   \"metadata\": {},","   \"source\": [","    \"### Задача 1.40\\n\",","    \"> Из 20 филиалов Сбербанка 10 расположены за чертой города. Для обследования случайным образом отобрано 5 филиалов. Какова вероятность того, что среди отобранных окажется в черте города: а) 3 филиала; б) хотя бы один?\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"14abc77c\",","   \"metadata\": {},","   \"source\": [","    \"* а) $P(A) = \\\\frac{C_{10}^3 \\\\cdot C_{10}^2}{C_{20}^5}$\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 19,","   \"id\": \"45c6950d\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"data\": {","      \"text/plain\": [","       \"np.float64(0.3483)\"","      ]","     },","     \"execution_count\": 19,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"round(sc.comb(10, 3) * sc.comb(10, 2) / sc.comb(20, 5), 4)\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"9671e93a\",","   \"metadata\": {},","   \"source\": [","    \"* б) $P(B) = 1 - \\\\frac{C_{10}^5}{C_{20}^5}$\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 20,","   \"id\": \"6f98d8c3\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"data\": {","      \"text/plain\": [","       \"np.float64(0.9837)\"","      ]","     },","     \"execution_count\": 20,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"round(1 - sc.comb(10, 5) / sc.comb(20, 5), 4)\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"d6d30dbe\",","   \"metadata\": {},","   \"source\": [","    \"### Задача 1.43\\n\",","    \"> Наудачу взятый телефонный номер состоит из 5 цифр. Какова вероятность того, что в нем все цифры: а) различные; б) одинаковые; в) нечетные? Известно, что номер телефона не начинается с цифры ноль.\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"978254a0\",","   \"metadata\": {},","   \"source\": [","    \"* а) $P(A) = \\\\frac{1}{0,9 \\\\cdot A_{10}^5}$\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 21,","   \"id\": \"6bea6438\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"data\": {","      \"text/plain\": [","       \"3.67e-05\"","      ]","     },","     \"execution_count\": 21,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"round(1 / (0.9 * math.perm(10, 5)), 7)\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"e74e5093\",","   \"metadata\": {},","   \"source\": [","    \"* б) $P(B) = \\\\frac{9}{9 \\\\cdot 10^4}$\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 22,","   \"id\": \"92a43462\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"data\": {","      \"text/plain\": [","       \"0.0001\"","      ]","     },","     \"execution_count\": 22,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"round(9 / (9 * 10**4), 5)\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"a3bec844\",","   \"metadata\": {},","   \"source\": [","    \"* в) $P(C) = \\\\frac{5^5}{9 \\\\cdot 10^4}$\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 23,","   \"id\": \"985a5464\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"data\": {","      \"text/plain\": [","       \"0.0347\"","      ]","     },","     \"execution_count\": 23,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"round(5 * (5**4) / (9 * 10**4), 4)\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"783b2099\",","   \"metadata\": {},","   \"source\": [","    \"### Задача 1.44\\n\",","    \"> Для проведения соревнования 16 волейбольных команд разбиты по жребию на две подгруппы (по восемь команд в каждой). Найти вероятность того, что две наиболее сильные команды окажутся: а) в разных подгруппах; б) в одной подгруппе.\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"f6486039\",","   \"metadata\": {},","   \"source\": [","    \"* а) $P(A) = \\\\frac{C_2^1 \\\\cdot C_{14}^7}{C_{16}^8}$\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 24,","   \"id\": \"794e16c1\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"data\": {","      \"text/plain\": [","       \"np.float64(0.5333)\"","      ]","     },","     \"execution_count\": 24,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"round(sc.comb(2, 1) * sc.comb(14, 7) / sc.comb(16, 8), 4)\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"0c5a0d9a\",","   \"metadata\": {},","   \"source\": [","    \"* б) $P(B) = \\\\frac{C_2^2 \\\\cdot C_{14}^6 + C_2^0 \\\\cdot C_{14}^8}{C_{16}^8}$\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 25,","   \"id\": \"9c756585\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"data\": {","      \"text/plain\": [","       \"np.float64(0.4667)\"","      ]","     },","     \"execution_count\": 25,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"round((sc.comb(2, 2) * sc.comb(14, 6) + sc.comb(2, 0) * sc.comb(14, 8)) / sc.comb(16, 8), 4)\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"994edd87\",","   \"metadata\": {},","   \"source\": [","    \"### Задача 1.46\\n\",","    \"> У сборщика имеются 10 деталей, мало отличающихся друг от друга, из них четыре — первого, по две — второго, третьего и четвертого видов. Какова вероятность того, что среди шести взятых одновременно деталей три окажутся первого вида, два — второго и одна — третьего?\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"142b9b73\",","   \"metadata\": {},","   \"source\": [","    \"* $P(A) = \\\\frac{C_4^3 \\\\cdot C_2^2 \\\\cdot C_2^1 \\\\cdot C_2^0}{C_{10}^6}$\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 26,","   \"id\": \"252873a4\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"data\": {","      \"text/plain\": [","       \"np.float64(0.0381)\"","      ]","     },","     \"execution_count\": 26,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"round((sc.comb(4, 3) * sc.comb(2, 2) * sc.comb(2, 1) * sc.comb(2, 0)) / sc.comb(10, 6), 4)\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"a83dc92c\",","   \"metadata\": {},","   \"source\": [","    \"### Задача 1.48\\n\",","    \"> В старинной игре в кости необходимо было для выигрыша получить при бросании трех игральных костей сумму очков, превосходящую 10. Найти вероятности: а) выпадения 11 очков; б) выигрыша.\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 27,","   \"id\": \"70e15934\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"data\": {","      \"text/plain\": [","       \"0.125\"","      ]","     },","     \"execution_count\": 27,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"m = 0\\n\",","    \"n = 0\\n\",","    \"\\n\",","    \"for q in range(1, 7):\\n\",","    \"    for w in range(1, 7):\\n\",","    \"        for e in range(1, 7):\\n\",","    \"            m += 1\\n\",","    \"            if q + w + e == 11:\\n\",","    \"                n += 1\\n\",","    \"\\n\",","    \"round(n / m, 4)\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 28,","   \"id\": \"156db4fb\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"data\": {","      \"text/plain\": [","       \"0.5\"","      ]","     },","     \"execution_count\": 28,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"m = 0\\n\",","    \"n = 0\\n\",","    \"\\n\",","    \"for q in range(1, 7):\\n\",","    \"    for w in range(1, 7):\\n\",","    \"        for e in range(1, 7):\\n\",","    \"            m += 1\\n\",","    \"            if q + w + e >10:\\n\",","    \"                n += 1\\n\",","    \"\\n\",","    \"round(n / m, 4)\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"611a9482\",","   \"metadata\": {},","   \"source\": [","    \"### Задача 1.50\\n\",","    \"> Два лица условились встретиться в определенном месте между 18 и 19 ч и договорились, что пришедший первым ждет другого в течение 15 мин., после чего уходит. Найти вероятность их встречи, если приход каждого в течение указанного часа может произойти в любое время и моменты прихода независимы.\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 29,","   \"id\": \"ab718ba6\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"data\": {","      \"text/plain\": [","       \"0.4375\"","      ]","     },","     \"execution_count\": 29,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"from scipy.integrate import quad\\n\",","    \"\\n\",","    \"def f1(x):\\n\",","    \"    return min(x + 15/60, 1)\\n\",","    \"\\n\",","    \"def f2(x):\\n\",","    \"    return max(x - 15/60, 0)\\n\",","    \"\\n\",","    \"r1 = quad(f1, 0, 1)\\n\",","    \"r2 = quad(f2, 0, 1)\\n\",","    \"\\n\",","    \"round(r1[0] - r2[0], 4)\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"4703bd0e\",","   \"metadata\": {},","   \"source\": [","    \"### Задача 1.51\\n\",","    \"> Какова вероятность того, что наудачу брошенная в круг точка окажется внутри вписанного в него квадрата?\"","   ]","  